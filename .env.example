# Copy to .env for local development. In production set these in your host's
# environment settings. Never commit real values.

# PostgreSQL. postgres:// and postgresql:// URLs are converted automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiproxy

# Admin API token, at least 32 characters. Generate: python -m aiproxy gen-admin-token
ADMIN_API_TOKEN=
# Optional: only these IPs/CIDRs can reach /admin (others get 404).
ADMIN_ALLOWED_IPS=
# Hostnames /admin answers on (default: RAILWAY_PUBLIC_DOMAIN when set, else any).
ADMIN_ALLOWED_HOSTS=
# Dashboard sessions: idle timeout, absolute lifetime, most open at once.
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=12
ADMIN_MAX_SESSIONS=20

# ---------------------------------------------------------------------------
# Provider credentials. Set <NAME>_API_KEY for each provider you want to offer;
# providers without a key are reported as unavailable. Any provider's base URL
# can be overridden with <NAME>_BASE_URL (e.g. a China region endpoint).
# Full list: aiproxy/connectors/catalog.py
# ---------------------------------------------------------------------------
# United States
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=
# Canada / France / Israel
COHERE_API_KEY=
MISTRAL_API_KEY=
LIGHTON_API_KEY=
AI21_API_KEY=
# China
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
BAIDU_API_KEY=
BAIDU_APPID=
TENCENT_API_KEY=
DOUBAO_API_KEY=
STEPFUN_API_KEY=
IFLYTEK_API_KEY=
BAICHUAN_API_KEY=
YI_API_KEY=
# South Korea / Japan / India / Singapore / UAE
UPSTAGE_API_KEY=
NAVER_API_KEY=
SAKANA_API_KEY=
PLAMO_API_KEY=
SARVAM_API_KEY=
KRUTRIM_API_KEY=
SEALION_API_KEY=
AI71_API_KEY=
# Russia
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_API_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Extra CA certificates for upstream TLS (GigaChat needs the Russian Trusted Root CA).
UPSTREAM_EXTRA_CA_FILE=

# Any other OpenAI-compatible API, as a JSON list, e.g.
# CUSTOM_PROVIDERS=[{"name":"aleph","base_url":"https://pharia.example.com/v1","country":"DE"}]
# ALEPH_API_KEY=...
CUSTOM_PROVIDERS=

# ---------------------------------------------------------------------------
# Fee charged once per completed round trip (US dollars).
DEFAULT_FEE_PER_REQUEST=0.03

# Requests per minute per key, unless the key has its own limit.
RATE_LIMIT_PER_MINUTE=60
# Requests per minute per client IP, before authentication.
IP_RATE_LIMIT_PER_MINUTE=3000

# Cost-abuse guards. MAX_OUTPUT_TOKENS=0 means no cap.
MAX_CHOICES=1
BLOCKED_SERVICE_TIERS=priority,scale
MAX_OUTPUT_TOKENS=0

# Reject plain-HTTP requests. Keep true in production; your host terminates TLS
# and sets X-Forwarded-Proto. Set false only for local development without TLS.
REQUIRE_HTTPS=true

# Optional: Stripe balance top-ups.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-site.example/billing/success
STRIPE_CANCEL_URL=https://your-site.example/billing/cancel
