# Copy to .env for local development. In production set these in your host's
# environment settings. Never commit real values.

# PostgreSQL. postgres:// and postgresql:// URLs are converted automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiproxy

# Admin API token, at least 32 characters. Generate: python -m aiproxy gen-admin-token
ADMIN_API_TOKEN=

# Upstream provider credentials. A provider with no key is reported as unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Fee charged per request when no pricing rule matches (US dollars).
DEFAULT_FEE_PER_REQUEST=0.03

# Requests per minute per key, unless the key has its own limit.
RATE_LIMIT_PER_MINUTE=60

# Reject plain-HTTP requests. Keep true in production; your host terminates TLS
# and sets X-Forwarded-Proto. Set false only for local development without TLS.
REQUIRE_HTTPS=true

# Optional: Stripe balance top-ups.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://your-site.example/billing/success
STRIPE_CANCEL_URL=https://your-site.example/billing/cancel
